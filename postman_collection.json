          "name": "Get Error - Non-Existent Product ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test(\"Error confirms product was not found\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "    pm.expect(json.error).to.equal(\"Not Found\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/507f1f77bcf86cd799439011",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "507f1f77bcf86cd799439011"]
            },
            "description": "Tests query for a valid ObjectId format that does not exist in database."
          }
        },
        {
          "name": "Update Error - Negative Stock & RunValidators Enforcement",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Validation error reports stock constraint violation on update\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "    pm.expect(json.details).to.have.property(\"stock\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": -10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/507f1f77bcf86cd799439011",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "507f1f77bcf86cd799439011"]
            },
            "description": "Verifies that Mongoose runValidators triggers on PUT updates when invalid data is supplied."
          }
        },
        {
          "name": "Delete Error - Non-Existent ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test(\"Error confirms not found on delete\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "    pm.expect(json.error).to.equal(\"Not Found\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/507f1f77bcf86cd799439011",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "507f1f77bcf86cd799439011"]
